{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://signoff-production-c2a8.up.railway.app/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://signoff-production-c2a8.up.railway.app/static/:path*"
    },
    { "source": "/((?!api/|static/|assets/).*)", "destination": "/index.html" }
  ]
}
