NODE_ENV=development
PORT=5000

# Local Mongo, or an Atlas connection string. In Docker Compose this is
# overridden to mongodb://mongo:27017/signoff.
MONGO_URI=mongodb://localhost:27017/signoff

# Generate real values with:  npm run keys
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ENCRYPTION_KEY=replace-me-64-hex-chars
LOOKUP_KEY=replace-me-64-hex-chars

ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Browser origin(s) allowed by CORS (comma-separated). The site the user opens.
CLIENT_ORIGIN=http://localhost:5173

# The PUBLIC origin that serves /static/ (the rendered GIF + social-icon PNGs).
# That full URL is embedded in the pasted signature and fetched by Gmail /
# Outlook servers, so it must be publicly reachable HTTPS in production — never
# localhost or an internal hostname.
#   - single domain (nginx proxies /api and /static to the API)  -> the CLIENT url
#       e.g. https://signoff.app
#   - API exposed on its own hostname                            -> the API url
#       e.g. https://api.signoff.app
PUBLIC_URL=http://localhost:5000

# Send the refresh cookie only over HTTPS. Keep false for a plain-HTTP
# localhost / Docker demo; set true (and serve HTTPS) in production.
COOKIE_SECURE=false

# SameSite mode for the refresh cookie: lax | strict | none.
# Leave blank and it's 'none' when COOKIE_SECURE=true, else 'lax'.
#
# 'none' is a CROSS-SITE cookie and modern browsers block those as third-party
# cookies — users get logged out on every reload. If the client reaches the API
# on its own origin (a Vercel/nginx rewrite proxying /api), set this to 'lax'.
# COOKIE_SAMESITE=lax
#
# Explicit cookie Domain, e.g. ".signoff.app", to share the session across
# sibling subdomains (app.signoff.app <-> api.signoff.app). Unset = host-only.
# COOKIE_DOMAIN=.signoff.app

STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# --- image hosting (STORAGE_DRIVER=s3) -----------------------------------
# With the local driver the rendered GIF + icons are served from PUBLIC_URL,
# so pasted signatures only work if the API is on a public HTTPS host. Point
# STORAGE_DRIVER at S3-compatible object storage instead and the images live
# on a CDN URL that Gmail / Outlook can always reach — no matter where (or
# whether) the API is deployed. Works with Cloudflare R2 (free egress),
# AWS S3, Backblaze B2, Supabase Storage, or MinIO.
#
# Cloudflare R2 quick setup:
#   1. Create a bucket.  2. Settings -> enable the r2.dev public URL (or add a
#   custom domain).  3. Create an API token, "Object Read & Write" on that
#   bucket.  4. Fill in the five values below, then: npm run icons
#
# S3_ENDPOINT       R2:  https://<accountid>.r2.cloudflarestorage.com
#                   B2:  https://s3.<region>.backblazeb2.com
#                   AWS: leave blank (derived from S3_REGION)
# S3_REGION         "auto" for R2; the real region for AWS/B2
# S3_PUBLIC_BASE_URL the browser-facing base: the r2.dev URL, a custom domain,
#                   or https://<bucket>.s3.<region>.amazonaws.com
# S3_FORCE_PATH_STYLE  true for R2/B2/MinIO, false for AWS S3
#
# Set STORAGE_DRIVER=s3 (above) to use the block below.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# --- email / OTP -----------------------------------------------------------
# Two ways to send verification codes. Leave both unconfigured for local dev:
# codes are printed to the server log and returned in the sign-up response.
#
# MAIL_PROVIDER=brevo  (recommended for hosted deploys)
#   Brevo's HTTP API, over port 443. Use this on Railway / Render / Fly / most
#   PaaS — they BLOCK outbound SMTP ports (25/465/587), so nodemailer just logs
#   "Connection timeout" and no mail goes out. Free tier: 300 emails/day.
#   Setup: brevo.com -> Senders -> add & verify your from-address (one click in
#   your inbox, no DNS needed) -> SMTP & API -> API Keys -> create a v3 key.
#   Then set BREVO_API_KEY and MAIL_FROM below. Auto-selected when the key is set.
#
# MAIL_PROVIDER=smtp
#   Classic SMTP via nodemailer. Fine locally and on hosts that allow :587.
#   Gmail: use an App Password and set MAIL_FROM to the same address (Gmail only
#   sends as the authenticated mailbox).
APP_NAME=Signoff
# MAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. "Name <email>" or a bare address. For Brevo this
# email must be a verified sender.
MAIL_FROM=no-reply@signoff.app

# Max verification emails per hour per IP (default 6).
# OTP_MAX_PER_HOUR=6
